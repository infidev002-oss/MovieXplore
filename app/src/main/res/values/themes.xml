<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Material 3 base: the kit's screens (splash, welcome back, force update, native ads) use AppCompat,
        MaterialButton and Material 3 color attributes. The app's own screens keep their platform widgets and
        the colors below.
    -->
    <style name="Theme.MovieXplore" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/AlertDialog</item>

        <!-- Material 3 colors, used by the kit layouts. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorOutlineVariant">@color/outline_faint</item>
    </style>

    <!--
        Full-height screen with no status bar (welcome back): the window covers the status bar area and the camera
        cutout. The navigation bar stays; the layout keeps its buttons above it (fitsSystemWindows).
    -->
    <style name="Theme.MovieXplore.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="AlertDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:background">@color/surface</item>
    </style>
</resources>

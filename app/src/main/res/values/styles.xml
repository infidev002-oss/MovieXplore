<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text styles, matching the sizes the app used before. -->
    <style name="Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Text.Headline">
        <item name="android:textSize">@dimen/_23ssp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.HeadlineSmall">
        <item name="android:textSize">@dimen/_20ssp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.TitleLarge">
        <item name="android:textSize">@dimen/_18ssp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.TitleMedium">
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:lineSpacingExtra">@dimen/_3ssp</item>
    </style>
    <style name="Text.BodyMedium">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>
    <style name="Text.BodyMedium.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <!-- The header at the top of each tab (Watchlist, Mood, Account): the same box, title and subtitle on every tab. -->
    <style name="TabHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/_13sdp</item>
        <item name="android:paddingTop">@dimen/_17sdp</item>
        <item name="android:paddingEnd">@dimen/_13sdp</item>
        <item name="android:paddingBottom">@dimen/_12sdp</item>
    </style>
    <style name="Text.TabTitle" parent="Text.HeadlineSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Text.TabSubtitle" parent="Text.BodyMedium.Secondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_3sdp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="Text.BodySmall">
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Buttons -->
    <style name="Button" parent="android:Widget.Material.Button" />
    <style name="Button.Primary">
        <item name="android:layout_height">@dimen/_43sdp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:paddingStart">@dimen/_17sdp</item>
        <item name="android:paddingEnd">@dimen/_17sdp</item>
    </style>
    <style name="Button.White" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_white</item>
        <item name="android:textColor">@color/background</item>
        <item name="android:textSize">@dimen/_14ssp</item>
    </style>
    <!-- Secondary pill beside a white one (e.g. onboarding Previous): faint glass fill with a light edge. -->
    <style name="Button.Outline" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/_14ssp</item>
    </style>
    <style name="Button.Text">
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:paddingStart">@dimen/_10sdp</item>
        <item name="android:paddingEnd">@dimen/_10sdp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- A full-screen dialog sliding up from the bottom, used for bottom sheets. -->
    <style name="BottomSheetDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <!-- No dark shade over the screen above the sheet. -->
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation</item>
        <!-- Transparent system bars like the screens behind, so the dialog doesn't paint a solid bar strip. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- Material's draggable sheet (showExpandableSheet): grows to full screen as its list is scrolled up. Same look
         as the other sheets: no dark shade, transparent system bars, and the sheet layout draws its own background. -->
    <style name="ExpandableSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ExpandableSheet</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="colorAccent">@color/primary</item>
    </style>
    <style name="ExpandableSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text styles, matching the sizes the app used before. -->
    <style name="Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Text.Headline">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.TitleLarge">
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>
    <style name="Text.BodyMedium">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Text.BodyMedium.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Buttons -->
    <style name="Button" parent="android:Widget.Material.Button" />
    <style name="Button.Primary">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="Button.White" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_white</item>
        <item name="android:textColor">@color/background</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Button.Text">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- A full-screen dialog sliding up from the bottom, used for bottom sheets. -->
    <style name="BottomSheetDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <!-- No dark shade over the screen above the sheet. -->
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation</item>
        <!-- Transparent system bars like the screens behind, so the dialog doesn't paint a solid bar strip. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>

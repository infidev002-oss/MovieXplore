<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: logo and name in the centre, progress and status ("please wait" / "turn on internet") at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/logo" />

        <TextView
            style="@style/Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_13sdp"
            android:text="@string/app_name" />
    </LinearLayout>

    <!-- Status, then the splash banner pinned to the bottom edge. -->
    <LinearLayout
        android:id="@+id/splash_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/splash_progress"
            android:layout_width="@dimen/_23sdp"
            android:layout_height="@dimen/_23sdp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:id="@+id/splash_status"
            style="@style/Text.BodyMedium.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_33sdp"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:gravity="center"
            android:text="Please wait…" />

        <!-- Splash banner (RemoteValues.BANNER_SPLASH), loaded by the kit's SplashFlow. -->
        <FrameLayout
            android:id="@+id/splash_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

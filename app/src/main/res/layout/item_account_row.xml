<?xml version="1.0" encoding="utf-8"?>
<!-- One Account row: its own rounded card with an icon, label and chevron. The label wraps rather than clipping. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card_row"
    android:stateListAnimator="@animator/press_scale"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/account_row_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/account_row_label"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textSize="15sp" />

    <!-- The row's current setting (e.g. the language), shown only on rows that have one. -->
    <TextView
        android:id="@+id/account_row_value"
        style="@style/Text.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxWidth="160dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>

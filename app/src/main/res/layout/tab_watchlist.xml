<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/watchlist_title"
        style="@style/TabHeader">

        <TextView
            style="@style/Text.TabTitle"
            android:text="Watchlist" />

        <TextView
            style="@style/Text.TabSubtitle"
            android:text="Movies and shows you saved" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_13sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_10sdp">

        <TextView
            android:id="@+id/watchlist_movies"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_17sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_17sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="Movie" />

        <TextView
            android:id="@+id/watchlist_tv"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:paddingStart="@dimen/_17sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_17sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="TV Shows" />
    </LinearLayout>

    <include
        android:id="@+id/watchlist_grid"
        layout="@layout/view_media_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Account: the tab header, a top panel (the signed-in user, or a sign-in
    card), one card per settings row, and the TMDB attribution.
    Responsive: every size is sdp / ssp (scales with the screen's smallest width, so phones and tablets keep
    the same proportions), each card is a ConstraintLayout, and side-by-side buttons share the width by
    weightSum. The content column is capped and centred in landscape / wide screens in ProfileFragment.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/profile_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Same header as the other tabs (TabHeader); the column already has the side padding. -->
            <LinearLayout
                android:id="@+id/profile_title"
                style="@style/TabHeader"
                android:paddingStart="0dp"
                android:paddingEnd="0dp">

                <TextView
                    style="@style/Text.TabTitle"
                    android:text="Account" />

                <TextView
                    style="@style/Text.TabSubtitle"
                    android:text="Sign-in, language and app settings" />
            </LinearLayout>

            <!--
                Top panel when signed out, styled like a movie poster: four trending posters fill the card, fade into
                the card colour (bg_sign_in_fade), and the film icon, a short reason to sign in and the Sign in with
                Google button sit centred on top. Posters are set in ProfileFragment; offline the card just shows its
                own gradient.
            -->
            <FrameLayout
                android:id="@+id/profile_sign_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/bg_profile_hero">

                <LinearLayout
                    android:id="@+id/profile_sign_in_posters"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_sign_in_fade" />

                <!-- Starts lower down, so the top of the posters shows above the text. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingTop="@dimen/_70sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:paddingBottom="@dimen/_14sdp">

                    <ImageView
                        android:id="@+id/profile_sign_in_icon"
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:background="@drawable/bg_profile_avatar_ring"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/_8sdp"
                        android:src="@drawable/ic_movie"
                        android:tint="@color/primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/profile_sign_in_title"
                        style="@style/Text.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:accessibilityHeading="true"
                        android:gravity="center"
                        android:text="Sign in to MovieXplore"
                        android:textSize="@dimen/_15ssp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/profile_sign_in_icon" />

                    <TextView
                        android:id="@+id/profile_sign_in_subtitle"
                        style="@style/Text.BodySmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:gravity="center"
                        android:text="Back up your watchlist and sync it across devices."
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/profile_sign_in_title" />

                    <!-- Google's official "Sign in with Google" button (light, pill, 180×40 dp) from
                         developers.google.com/identity/branding-guidelines. Scaled with the screen but never
                         stretched (adjustViewBounds keeps its ratio); don't recolour or redraw it. -->
                    <ImageView
                        android:id="@+id/profile_google_sign_in"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:adjustViewBounds="true"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:contentDescription="Sign in with Google"
                        android:focusable="true"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/btn_google_sign_in"
                        android:stateListAnimator="@animator/press_scale"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/profile_sign_in_subtitle" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- Top panel when signed in: avatar, name, email and sync status. Logout is a settings row below. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:background="@drawable/bg_profile_hero"
                android:padding="@dimen/_12sdp"
                android:visibility="gone">

                <!-- The initial shows until (or unless) the Google photo loads on top of it. -->
                <FrameLayout
                    android:id="@+id/profile_avatar"
                    android:layout_width="@dimen/_44sdp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_profile_avatar_ring"
                    android:padding="@dimen/_2sdp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/profile_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_profile_avatar"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_16ssp" />

                    <!-- Clipped to a circle in ProfileFragment. -->
                    <ImageView
                        android:id="@+id/profile_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <TextView
                    android:id="@+id/profile_name"
                    style="@style/Text.TitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintBottom_toTopOf="@id/profile_email"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/profile_avatar"
                    app:layout_constraintTop_toTopOf="@id/profile_avatar"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/profile_email"
                    style="@style/Text.BodySmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintBottom_toTopOf="@id/profile_synced"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/profile_name"
                    app:layout_constraintTop_toBottomOf="@id/profile_name" />

                <LinearLayout
                    android:id="@+id/profile_synced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_profile_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingEnd="@dimen/_8sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    app:layout_constraintBottom_toBottomOf="@id/profile_avatar"
                    app:layout_constraintStart_toStartOf="@id/profile_name"
                    app:layout_constraintTop_toBottomOf="@id/profile_email">

                    <ImageView
                        android:layout_width="@dimen/_11sdp"
                        android:layout_height="@dimen/_11sdp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cloud_done"
                        android:tint="@color/primary" />

                    <TextView
                        style="@style/Text.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Watchlist synced"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Settings native ad (RemoteValues.NATIVE_SETTINGS), small, under the top panel. The kit shows it and adds its spacing. -->
            <FrameLayout
                android:id="@+id/profile_native"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- One card per settings row, added in ProfileFragment. -->
            <LinearLayout
                android:id="@+id/profile_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_tmdb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_row"
                android:padding="@dimen/_12sdp"
                android:stateListAnimator="@animator/press_scale">

                <ImageView
                    android:id="@+id/profile_tmdb_logo"
                    android:layout_width="@dimen/_56sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:contentDescription="The Movie Database logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/profile_tmdb_title"
                    style="@style/Text.TitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="TMDB License"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintBottom_toTopOf="@id/profile_tmdb_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/profile_tmdb_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/profile_tmdb_text"
                    style="@style/Text.BodySmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="This app uses the TMDB API but is not endorsed or certified by TMDB."
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/profile_tmdb_title"
                    app:layout_constraintTop_toBottomOf="@id/profile_tmdb_title" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/profile_status_scrim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_34sdp"
        android:alpha="0"
        android:background="@drawable/bg_status_scrim" />
</FrameLayout>

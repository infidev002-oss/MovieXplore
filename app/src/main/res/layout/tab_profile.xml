<?xml version="1.0" encoding="utf-8"?>
<!--
    Account: a top bar with Back, the signed-in user (or a sign-in card), one card per settings row, and the
    TMDB attribution. The content column is capped and centred on wide screens in ProfileFragment.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/profile_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/profile_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/profile_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="-8dp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@animator/press_scale"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <TextView
                    style="@style/Text.TitleLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="Account" />
            </LinearLayout>

            <!-- Shown when signed out. -->
            <LinearLayout
                android:id="@+id/profile_sign_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_row"
                android:stateListAnimator="@animator/press_scale"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_account_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign in to Account" />

                    <TextView
                        style="@style/Text.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sign in to your account to access synced content." />
                </LinearLayout>

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login"
                    android:textColor="@color/year" />
            </LinearLayout>

            <!-- Shown when signed in. -->
            <LinearLayout
                android:id="@+id/profile_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_account_circle" />

                <TextView
                    android:id="@+id/profile_name"
                    style="@style/Text.TitleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2" />
            </LinearLayout>

            <!-- One card per settings row, added in ProfileFragment. -->
            <LinearLayout
                android:id="@+id/profile_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Native ad (kit NativeAds, RemoteValues.NATIVE_SETTINGS); shown by NativeAds.attach. -->
            <FrameLayout
                android:id="@+id/profile_native"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/profile_tmdb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_row"
                android:stateListAnimator="@animator/press_scale"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="49dp"
                    android:contentDescription="The Movie Database logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TMDB License" />

                    <TextView
                        style="@style/Text.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="This app uses the TMDB API but is not endorsed or certified by TMDB." />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/profile_status_scrim"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:alpha="0"
        android:background="@drawable/bg_status_scrim" />
</FrameLayout>

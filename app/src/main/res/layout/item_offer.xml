<?xml version="1.0" encoding="utf-8"?>
<!-- A streaming service card: logo, name, and how it offers the title (Stream / Rent / Buy...). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_card_row"
    android:stateListAnimator="@animator/press_scale"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/offer_logo_frame"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_rounded_placeholder">

        <ImageView
            android:id="@+id/offer_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/offer_name"
        style="@style/Text.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="2"
        android:maxLines="2" />

    <TextView
        android:id="@+id/offer_type"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/primary" />
</LinearLayout>
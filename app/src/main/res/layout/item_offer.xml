<?xml version="1.0" encoding="utf-8"?>
<!-- A streaming service card: logo, name, and how it offers the title (Stream / Rent / Buy...). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_92sdp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/_8sdp"
    android:background="@drawable/bg_card_row"
    android:stateListAnimator="@animator/press_scale"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/_7sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_7sdp"
    android:paddingBottom="@dimen/_10sdp">

    <FrameLayout
        android:id="@+id/offer_logo_frame"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:background="@drawable/bg_rounded_placeholder">

        <ImageView
            android:id="@+id/offer_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/offer_name"
        style="@style/Text.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="2"
        android:maxLines="2" />

    <TextView
        android:id="@+id/offer_type"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:textColor="@color/primary" />
</LinearLayout>
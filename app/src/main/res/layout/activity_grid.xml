<?xml version="1.0" encoding="utf-8"?>
<!-- A titled poster grid: categories ("Trending Movies") and mood results (with Movies / TV Shows pills). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <LinearLayout
        android:id="@+id/grid_pills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_7sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_7sdp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pill_movies"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_17sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_17sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="Movies" />

        <TextView
            android:id="@+id/pill_tv"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:paddingStart="@dimen/_17sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_17sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="TV Shows" />
    </LinearLayout>

    <include
        android:id="@+id/screen_grid"
        layout="@layout/view_media_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/view_banner" />
</LinearLayout>

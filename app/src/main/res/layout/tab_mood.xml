<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/mood_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mood_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/mood_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="4dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.HeadlineSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="How are you feeling?" />

                    <TextView
                        android:id="@+id/mood_subtitle"
                        style="@style/Text.BodyMedium.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2" />
                </LinearLayout>

                <Button
                    android:id="@+id/mood_clear"
                    style="@style/Button.Text"
                    android:layout_width="wrap_content"
                    android:text="Clear"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mood_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <LinearLayout
                android:id="@+id/mood_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/mood_status_scrim"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:alpha="0"
        android:background="@drawable/bg_status_scrim" />

    <!-- Appears once a mood is picked, just above the tab bar, so it's reachable without scrolling. -->
    <Button
        android:id="@+id/mood_find"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="12dp"
        android:visibility="gone" />
</FrameLayout>
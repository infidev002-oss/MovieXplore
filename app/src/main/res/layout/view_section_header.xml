<?xml version="1.0" encoding="utf-8"?>
<!--
    Row title with the app's signature accent bar on the left and, for rows with more to see, a
    "See all" pill on the right. The whole header is the tap target; pressing it shrinks only the pill
    (duplicateParentState), instead of highlighting the full width of the row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_43sdp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_13sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingEnd="@dimen/_13sdp"
    android:paddingBottom="@dimen/_10sdp">

    <View
        android:layout_width="@dimen/_3sdp"
        android:layout_height="@dimen/_18sdp"
        android:background="@drawable/bg_section_accent" />

    <TextView
        android:id="@+id/section_title"
        style="@style/Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:letterSpacing="-0.01"
        android:maxLines="1"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/section_chevron"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_see_all"
        android:drawableEnd="@drawable/ic_chevron_right_small"
        android:drawablePadding="@dimen/_2sdp"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/_4sdp"
        android:paddingEnd="@dimen/_5sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:stateListAnimator="@animator/press_scale"
        android:text="See all"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_11ssp"
        android:visibility="gone" />
</LinearLayout>

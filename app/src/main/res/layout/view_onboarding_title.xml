<?xml version="1.0" encoding="utf-8"?>
<!-- An onboarding page's title with the app's accent bar (like row titles) and a short line under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_17sdp"
    android:paddingTop="@dimen/_23sdp"
    android:paddingEnd="@dimen/_17sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/_3sdp"
            android:layout_height="@dimen/_22sdp"
            android:background="@drawable/bg_section_accent" />

        <TextView
            android:id="@+id/page_title"
            style="@style/Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:letterSpacing="-0.01"
            android:textSize="@dimen/_22ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/page_subtitle"
        style="@style/Text.BodyMedium.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_5sdp" />
</LinearLayout>

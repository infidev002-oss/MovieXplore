<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding page "How It Works": title and four tip cards, scrolling on short screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_onboarding_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <!-- One card per tip (item_onboarding_tip), added by OnboardingPages. -->
        <LinearLayout
            android:id="@+id/onboarding_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </ScrollView>
</LinearLayout>

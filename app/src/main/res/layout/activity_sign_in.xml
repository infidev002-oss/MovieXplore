<?xml version="1.0" encoding="utf-8"?>
<!-- Google sign-in: close button, the logo, why to sign in, and the one Google button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sign_in_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/sign_in_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Close"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:stateListAnimator="@animator/press_scale" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no"
            android:src="@drawable/logo" />

        <TextView
            style="@style/Text.HeadlineSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="Sign in to MovieXplore" />

        <TextView
            style="@style/Text.BodyMedium.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Save your watchlist to your Google account and keep it on every device." />

        <Button
            android:id="@+id/sign_in_google"
            style="@style/Button.White"
            android:layout_width="match_parent"
            android:layout_marginTop="28dp"
            android:text="Continue with Google" />

        <ProgressBar
            android:id="@+id/sign_in_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/primary"
            android:visibility="invisible" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Hosts the four tabs; only the selected tab's view is visible. The floating tab bar sits on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    tools:context=".ui.main.MainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The main screen's banner (RemoteValues.BANNER_HOME), shown on every tab. Pinned to the top edge so it
             can be a collapsible banner ("collapsiblePosition": "top" in Remote Config). While shown it covers the
             status bar area and the tabs start below it (MainActivity.fitBanner). -->
        <include
            android:id="@+id/main_banner"
            layout="@layout/view_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/tab_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Frosted glass over the scrolling content (blur turned on in MainActivity, Android 12+). -->
    <com.movies.moviexplore.ui.common.GlassFrameLayout
        android:id="@+id/nav_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="@dimen/_7sdp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_13sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_13sdp"
            android:paddingBottom="@dimen/_8sdp">

            <ImageButton
                android:id="@+id/tab_home"
                android:layout_width="@dimen/_43sdp"
                android:layout_height="@dimen/_43sdp"
                android:background="@drawable/bg_nav_item"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Home"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/tab_watchlist"
                android:layout_width="@dimen/_43sdp"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginStart="@dimen/_17sdp"
                android:background="@drawable/bg_nav_item"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Watchlist"
                android:src="@drawable/ic_bookmark" />

            <ImageButton
                android:id="@+id/tab_mood"
                android:layout_width="@dimen/_43sdp"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginStart="@dimen/_17sdp"
                android:background="@drawable/bg_nav_item"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Mood"
                android:src="@drawable/ic_mood" />

            <ImageButton
                android:id="@+id/tab_profile"
                android:layout_width="@dimen/_43sdp"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginStart="@dimen/_17sdp"
                android:background="@drawable/bg_nav_item"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Profile"
                android:src="@drawable/ic_person" />
        </LinearLayout>
    </com.movies.moviexplore.ui.common.GlassFrameLayout>
</FrameLayout>
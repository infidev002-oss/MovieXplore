<?xml version="1.0" encoding="utf-8"?>
<!--
    The frosted-glass card over hero artwork on Home and Details: title, rating, meta, optional
    overview, action + bookmark. The screen turns on the blur with GlassFrameLayout.enableBlur.
-->
<com.movies.moviexplore.ui.common.GlassFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_info_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_17sdp">

        <TextView
            android:id="@+id/info_title"
            style="@style/Text.HeadlineSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />

        <include
            android:id="@+id/info_rating"
            layout="@layout/view_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp" />

        <TextView
            android:id="@+id/info_meta"
            style="@style/Text.BodyMedium.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp" />

        <!-- Justified overview text (TextViewStyler spreads each full line to the card's width). -->
        <com.movies.moviexplore.textview.TextViewStyler
            android:id="@+id/info_overview"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/info_read_more"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:stateListAnimator="@animator/press_scale"
            android:gravity="center"
            android:paddingTop="@dimen/_7sdp"
            android:paddingBottom="@dimen/_7sdp"
            android:text="Read More"
            android:textColor="@color/link"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_13sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/info_action"
                style="@style/Button.White"
                android:layout_width="0dp"
                android:layout_height="@dimen/_42sdp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="@dimen/_5sdp"
                android:drawableTint="@color/background"
                android:textSize="@dimen/_13ssp" />

            <ImageButton
                android:id="@+id/info_bookmark"
                android:layout_width="@dimen/_42sdp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@drawable/bg_icon_button_outline"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Add to watchlist"
                android:src="@drawable/ic_bookmark" />
        </LinearLayout>

        <!-- Opens the Watch Availability sheet: streaming services per country. Styled to match the bookmark. -->
        <Button
            android:id="@+id/info_watch_availability"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_button_outline"
            android:drawableStart="@drawable/ic_tv"
            android:drawablePadding="@dimen/_7sdp"
            android:drawableTint="@color/text_primary"
            android:text="Watch Availability"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</com.movies.moviexplore.ui.common.GlassFrameLayout>

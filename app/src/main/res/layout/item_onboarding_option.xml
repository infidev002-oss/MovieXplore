<?xml version="1.0" encoding="utf-8"?>
<!--
    One language / country choice: a glass card with a round badge (language code or flag), the name with
    a second line (native name), and a ring that becomes a filled check when selected. Padding gives the
    gap between cards, so the list needs no divider.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_17sdp"
    android:paddingTop="@dimen/_4sdp"
    android:paddingEnd="@dimen/_17sdp"
    android:paddingBottom="@dimen/_4sdp">

    <LinearLayout
        android:id="@+id/option_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_onboarding_option"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_53sdp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:stateListAnimator="@animator/press_scale">

        <TextView
            android:id="@+id/option_badge"
            style="@style/Text.Label"
            android:layout_width="@dimen/_37sdp"
            android:layout_height="@dimen/_37sdp"
            android:background="@drawable/bg_round"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textSize="@dimen/_12ssp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/option_title"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/option_subtitle"
                style="@style/Text.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/option_mark"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:background="@drawable/bg_onboarding_radio">

            <ImageView
                android:id="@+id/option_check"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                android:tint="@color/background" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

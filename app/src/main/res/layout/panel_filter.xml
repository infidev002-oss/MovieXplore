<?xml version="1.0" encoding="utf-8"?>
<!-- Right-side filter drawer over a dimmed screen. Edits a draft and only reports it back on Apply. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:id="@+id/filter_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <LinearLayout
        android:id="@+id/filter_panel"
        android:layout_width="@dimen/_267sdp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/panel"
        android:clickable="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/filter_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/panel_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_7sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingEnd="@dimen/_7sdp"
            android:paddingBottom="@dimen/_5sdp">

            <ImageButton
                android:id="@+id/filter_back"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                android:visibility="gone" />

            <TextView
                android:id="@+id/filter_title"
                style="@style/Text.HeadlineSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:text="Filter" />

            <ImageButton
                android:id="@+id/filter_close"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Close filters"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/filter_summary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_13sdp"
                android:paddingEnd="@dimen/_13sdp"
                android:paddingBottom="@dimen/_20sdp" />
        </ScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filter_options"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:id="@+id/filter_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <!-- Same pair as the info card's "Watch Now" + bookmark: white pill, outlined round icon button. -->
            <Button
                android:id="@+id/filter_apply"
                style="@style/Button.White"
                android:layout_width="0dp"
                android:layout_height="@dimen/_42sdp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="@dimen/_5sdp"
                android:drawableTint="@color/background"
                android:text="Apply"
                android:textSize="@dimen/_13ssp" />

            <ImageButton
                android:id="@+id/filter_reset"
                android:layout_width="@dimen/_42sdp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@drawable/bg_icon_button_outline"
                android:stateListAnimator="@animator/press_scale"
                android:contentDescription="Reset filters"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
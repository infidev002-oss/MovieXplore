<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.details.DetailsActivity">

    <ScrollView
        android:id="@+id/details_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/details_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- The backdrop. Its height (and the card's overlap) is set in DetailsActivity.fitHero from the width. -->
                <FrameLayout
                    android:id="@+id/details_art_frame"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_250sdp"
                    android:background="@color/surface_high">

                    <ImageView
                        android:layout_width="@dimen/_47sdp"
                        android:layout_height="@dimen/_47sdp"
                        android:layout_gravity="center"
                        android:alpha="0.6"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_movie"
                        android:tint="@color/text_secondary" />

                    <ImageView
                        android:id="@+id/details_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <View
                        android:id="@+id/details_art_fade"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_125sdp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_gradient_bottom" />
                </FrameLayout>

                <include
                    android:id="@+id/details_card"
                    layout="@layout/view_info_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_13sdp"
                    android:layout_marginTop="@dimen/_183sdp"
                    android:layout_marginEnd="@dimen/_13sdp" />

                <!-- Over the artwork's top-left corner; it scrolls away with the page. -->
                <include layout="@layout/view_back_button" />
            </FrameLayout>

            <!-- Details banner (RemoteValues.BANNER_INFO): inline adaptive, inside the scrolling content. -->
            <include layout="@layout/view_banner" />

            <LinearLayout
                android:id="@+id/details_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_27sdp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/details_state"
        layout="@layout/view_state" />

    <View
        android:id="@+id/details_status_scrim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_33sdp"
        android:alpha="0"
        android:background="@drawable/bg_status_scrim" />

</FrameLayout>
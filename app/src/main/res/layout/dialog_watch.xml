<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Availability bottom sheet: country dropdown, then the services offering the title there. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/Text.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Watch Availability" />

    <TextView
        android:id="@+id/watch_country_label"
        style="@style/Text.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:text="Country"
        android:visibility="gone" />

    <!-- Built-in Spinner as the country dropdown, styled as a field with an arrow. -->
    <FrameLayout
        android:id="@+id/watch_country_field"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_dropdown"
        android:visibility="gone">

        <Spinner
            android:id="@+id/watch_country"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:dropDownVerticalOffset="4dp"
            android:popupBackground="@drawable/bg_dropdown"
            android:spinnerMode="dropdown" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/text_secondary" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:layout_marginTop="14dp">

        <HorizontalScrollView
            android:id="@+id/watch_offers_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/watch_offers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/watch_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary" />

        <LinearLayout
            android:id="@+id/watch_message_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:id="@+id/watch_message"
                style="@style/Text.BodyMedium.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center" />

            <Button
                android:id="@+id/watch_retry"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:text="Retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- TMDB's terms require crediting JustWatch wherever its watch-provider data is shown. -->
    <TextView
        style="@style/Text.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Availability data by JustWatch" />
</LinearLayout>
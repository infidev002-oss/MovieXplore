<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Availability bottom sheet: country dropdown, then the services offering the title there. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="@dimen/_17sdp"
    android:paddingBottom="@dimen/_13sdp">

    <TextView
        style="@style/Text.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_13sdp"
        android:text="Watch Availability" />

    <TextView
        android:id="@+id/watch_country_label"
        style="@style/Text.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="Country"
        android:visibility="gone" />

    <!-- Built-in Spinner as the country dropdown, styled as a field with an arrow. -->
    <FrameLayout
        android:id="@+id/watch_country_field"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_47sdp"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_13sdp"
        android:background="@drawable/bg_dropdown"
        android:visibility="gone">

        <Spinner
            android:id="@+id/watch_country"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:dropDownVerticalOffset="@dimen/_3sdp"
            android:popupBackground="@drawable/bg_dropdown"
            android:spinnerMode="dropdown" />

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/_10sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/text_secondary" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_147sdp"
        android:layout_marginTop="@dimen/_12sdp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/watch_offers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="@dimen/_13sdp"
            android:paddingEnd="@dimen/_5sdp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <ProgressBar
            android:id="@+id/watch_loading"
            android:layout_width="@dimen/_33sdp"
            android:layout_height="@dimen/_33sdp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary" />

        <LinearLayout
            android:id="@+id/watch_message_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/_27sdp"
            android:paddingEnd="@dimen/_27sdp">

            <TextView
                android:id="@+id/watch_message"
                style="@style/Text.BodyMedium.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center" />

            <Button
                android:id="@+id/watch_retry"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:text="Retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- TMDB's terms require crediting JustWatch wherever its watch-provider data is shown. -->
    <TextView
        style="@style/Text.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="Availability data by JustWatch" />
</LinearLayout>
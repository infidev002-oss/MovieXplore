<?xml version="1.0" encoding="utf-8"?>
<!-- A poster grid (3 columns on phones in portrait, more when wider: PagedGrid) with a "loading more" spinner and a loading/error/empty state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Columns, spacing and paging are set up by PagedGrid. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/media_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/_3sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:paddingBottom="@dimen/_20sdp"
        android:scrollbars="none" />

    <ProgressBar
        android:id="@+id/grid_loading_more"
        android:layout_width="@dimen/_23sdp"
        android:layout_height="@dimen/_23sdp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/_13sdp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <include
        android:id="@+id/grid_state"
        layout="@layout/view_state" />
</FrameLayout>

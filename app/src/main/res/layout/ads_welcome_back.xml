<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome-back screen (kit WelcomeBackActivity), movie-app style: a tilted wall of trending posters behind,
     fading into the app background, with "Welcome back" and the white Start pill at the bottom.
     Kit contract (AGENTS.md §4): ads_welcome_start (required; disabled by the kit until the ad is ready),
     ads_welcome_subtitle and ads_welcome_progress. One layout for portrait and landscape; the content scrolls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ads_welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Posters, tilted and a little enlarged so the edges stay covered. -->
    <com.movies.moviexplore.ui.welcome.WelcomePosterWall
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:rotation="-8"
        android:scaleX="1.25"
        android:scaleY="1.25" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/welcome_wall_fade" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/_20sdp"
            android:paddingTop="@dimen/_40sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingBottom="@dimen/_47sdp">

            <!-- Brand line: the app's name with a film icon. -->
            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_movie"
                android:drawablePadding="@dimen/_5sdp"
                android:drawableTint="@color/primary"
                android:gravity="center_vertical"
                android:letterSpacing="0.06"
                android:text="@string/app_name"
                android:textColor="@color/primary"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/ads_welcome_title"
                style="@style/Text.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/ads_welcome_back"
                android:textSize="@dimen/_23ssp" />

            <TextView
                android:id="@+id/ads_welcome_subtitle"
                style="@style/Text.BodyMedium.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:gravity="center"
                android:maxWidth="@dimen/_267sdp"
                android:textSize="@dimen/_12ssp" />

            <!-- Start: the app's white pill with a play icon; a faint glass pill with a spinner until the kit enables
                 it. A plain container, not a Button: this AppCompat screen would turn a Button into a tinted MaterialButton. -->
            <FrameLayout
                android:layout_width="@dimen/_220sdp"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginTop="@dimen/_27sdp">

                <FrameLayout
                    android:id="@+id/ads_welcome_start"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ads_welcome_start_bg"
                    android:clickable="true"
                    android:contentDescription="@string/ads_welcome_start"
                    android:enabled="false"
                    android:focusable="true"
                    android:stateListAnimator="@animator/press_scale">

                    <!-- Follows the pill's enabled state (duplicateParentState) for its text and icon colours. -->
                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawableStart="@drawable/ic_play"
                        android:drawablePadding="@dimen/_5sdp"
                        android:drawableTint="@color/ads_welcome_start_icon"
                        android:duplicateParentState="true"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:text="@string/ads_welcome_start"
                        android:textColor="@color/ads_welcome_start_text"
                        android:textSize="@dimen/_14ssp" />
                </FrameLayout>

                <ProgressBar
                    android:id="@+id/ads_welcome_progress"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

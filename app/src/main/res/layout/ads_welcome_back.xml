<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome-back screen (WelcomeBackActivity). SAMPLE design: redesign it to match your app. Required: a clickable
     view with id ads_welcome_start. Optional: ads_welcome_icon, ads_welcome_subtitle, ads_welcome_progress, ads_welcome_hero.
     One layout for portrait and landscape (no layout-land): keep it scrollable. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ads_welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Hero: rings + app icon card -->
        <FrameLayout
            android:id="@+id/ads_welcome_hero"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/ads_welcome_hero">

            <View
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:alpha="0.12"
                android:background="@drawable/ads_welcome_ring" />

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:alpha="0.25"
                android:background="@drawable/ads_welcome_ring" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/ads_welcome_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <TextView
            android:id="@+id/ads_welcome_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/ads_welcome_back"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ads_welcome_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ads_welcome_start"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:enabled="false"
                android:text="@string/ads_welcome_start"
                android:textSize="16sp"
                app:cornerRadius="28dp" />

            <ProgressBar
                android:id="@+id/ads_welcome_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:indeterminate="true" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- One tip on the onboarding "How It Works" screen: a glass card (as the choice cards) with a tinted round icon, a title and a short line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8sdp"
    android:background="@drawable/bg_onboarding_option"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_60sdp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_10sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingEnd="@dimen/_13sdp"
    android:paddingBottom="@dimen/_10sdp">

    <FrameLayout
        android:layout_width="@dimen/_37sdp"
        android:layout_height="@dimen/_37sdp"
        android:background="@drawable/bg_tip_icon">

        <ImageView
            android:id="@+id/tip_icon"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tip_title"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_13ssp" />

        <TextView
            android:id="@+id/tip_text"
            style="@style/Text.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>

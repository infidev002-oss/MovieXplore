<?xml version="1.0" encoding="utf-8"?><!--
    Home: a Netflix-style hero (artwork with the title, details and two buttons placed directly on it,
    about 60% of the screen tall) over rows of titles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Height is set in code to ~60% of the screen. -->
                <FrameLayout
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_433sdp">

                    <!-- Slider: the neighbours sit one screen-width to either side and follow the finger. -->
                    <ImageView
                        android:id="@+id/hero_image_prev"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/hero_image_next"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/hero_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_133sdp"
                        android:background="@drawable/bg_gradient_top" />

                    <!-- A tall fade into the page background keeps the title and buttons readable on any artwork. -->
                    <View
                        android:id="@+id/hero_fade"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_250sdp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_gradient_bottom" />

                    <LinearLayout
                        android:id="@+id/home_top_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_7sdp"
                        android:paddingEnd="@dimen/_7sdp">

                        <TextView
                            android:id="@+id/home_tab_home"
                            style="@style/Text.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/_7sdp"
                            android:paddingTop="@dimen/_4sdp"
                            android:paddingEnd="@dimen/_7sdp"
                            android:paddingBottom="@dimen/_11sdp"
                            android:text="Home"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/home_tab_movies"
                            style="@style/Text.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_2sdp"
                            android:background="@android:color/transparent"
                            android:paddingStart="@dimen/_7sdp"
                            android:paddingTop="@dimen/_4sdp"
                            android:paddingEnd="@dimen/_7sdp"
                            android:paddingBottom="@dimen/_11sdp"
                            android:stateListAnimator="@animator/press_scale"
                            android:text="Movies"
                            android:textColor="#B3F2F5F8" />

                        <TextView
                            android:id="@+id/home_tab_tv"
                            style="@style/Text.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_2sdp"
                            android:background="@android:color/transparent"
                            android:paddingStart="@dimen/_7sdp"
                            android:paddingTop="@dimen/_4sdp"
                            android:paddingEnd="@dimen/_7sdp"
                            android:paddingBottom="@dimen/_11sdp"
                            android:stateListAnimator="@animator/press_scale"
                            android:text="TV Shows"
                            android:textColor="#B3F2F5F8" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hero_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_20sdp"
                        android:paddingEnd="@dimen/_20sdp"
                        android:paddingBottom="@dimen/_7sdp">

                        <TextView
                            android:id="@+id/hero_title"
                            style="@style/Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:shadowColor="#99000000"
                            android:shadowDy="2"
                            android:shadowRadius="10"
                            android:textSize="@dimen/_27ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_meta"
                            style="@style/Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_7sdp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:shadowColor="#99000000"
                            android:shadowRadius="6"
                            android:textColor="#DDF2F5F8"
                            android:textSize="@dimen/_12ssp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_15sdp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/hero_info"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/_34sdp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_button_white"
                                android:contentDescription="Info"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:stateListAnimator="@animator/press_scale">

                                <ImageView
                                    android:layout_width="@dimen/_16sdp"
                                    android:layout_height="@dimen/_16sdp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_info"
                                    android:tint="@color/background" />

                                <TextView
                                    style="@style/Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_7sdp"
                                    android:importantForAccessibility="no"
                                    android:text="Info"
                                    android:textColor="@color/background"
                                    android:textSize="@dimen/_12ssp" />
                            </LinearLayout>

                            <!-- Frosted glass over the artwork (blur turned on in HomeFragment, Android 12+). -->
                            <com.movies.moviexplore.ui.common.GlassFrameLayout
                                android:id="@+id/hero_list"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/_34sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_button_glass"
                                android:clickable="true"
                                android:focusable="true"
                                android:stateListAnimator="@animator/press_scale">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:id="@+id/hero_list_icon"
                                        android:layout_width="@dimen/_16sdp"
                                        android:layout_height="@dimen/_16sdp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_add" />

                                    <TextView
                                        style="@style/Text.Label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/_7sdp"
                                        android:importantForAccessibility="no"
                                        android:text="My List"
                                        android:textSize="@dimen/_12ssp" />
                                </LinearLayout>
                            </com.movies.moviexplore.ui.common.GlassFrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/hero_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_3sdp"
                            android:layout_marginTop="@dimen/_13sdp"
                            android:divider="@drawable/space_indicator_gap"
                            android:orientation="horizontal"
                            android:showDividers="middle" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Home native ad (RemoteValues.NATIVE_HOME), medium. The kit shows it and adds its spacing. -->
                <FrameLayout
                    android:id="@+id/home_native"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_13sdp"
                    android:layout_marginBottom="@dimen/_1sdp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/home_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/home_state"
            layout="@layout/view_state" />

        <View
            android:id="@+id/home_status_scrim"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_33sdp"
            android:alpha="0"
            android:background="@drawable/bg_status_scrim" />
    </FrameLayout>
</LinearLayout>

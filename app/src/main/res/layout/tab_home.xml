<?xml version="1.0" encoding="utf-8"?>
<!--
    Home: a Netflix-style hero (artwork with the title, details and two buttons placed directly on it,
    about 60% of the screen tall) over rows of titles.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Height is set in code to ~60% of the screen. -->
            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="520dp">

                <!-- Slider: the neighbours sit one screen-width to either side and follow the finger. -->
                <ImageView
                    android:id="@+id/hero_image_prev"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/hero_image_next"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_gradient_top" />

                <!-- A tall fade into the page background keeps the title and buttons readable on any artwork. -->
                <View
                    android:id="@+id/hero_fade"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_gradient_bottom" />

                <LinearLayout
                    android:id="@+id/home_top_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/home_tab_home"
                        style="@style/Text.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="13dp"
                        android:text="Home"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_tab_movies"
                        style="@style/Text.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:background="@android:color/transparent"
                        android:stateListAnimator="@animator/press_scale"
                        android:paddingStart="8dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="13dp"
                        android:text="Movies"
                        android:textColor="#B3F2F5F8" />

                    <TextView
                        android:id="@+id/home_tab_tv"
                        style="@style/Text.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:background="@android:color/transparent"
                        android:stateListAnimator="@animator/press_scale"
                        android:paddingStart="8dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="13dp"
                        android:text="TV Shows"
                        android:textColor="#B3F2F5F8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/hero_title"
                        style="@style/Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#99000000"
                        android:shadowDy="2"
                        android:shadowRadius="10"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hero_meta"
                        style="@style/Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowRadius="6"
                        android:textColor="#DDF2F5F8"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/hero_info"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_white"
                            android:stateListAnimator="@animator/press_scale"
                            android:contentDescription="Info"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_info"
                                android:tint="@color/background" />

                            <TextView
                                style="@style/Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:importantForAccessibility="no"
                                android:text="Info"
                                android:textColor="@color/background"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Frosted glass over the artwork (blur turned on in HomeFragment, Android 12+). -->
                        <com.movies.myapplication.ui.common.GlassFrameLayout
                            android:id="@+id/hero_list"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_glass"
                            android:clickable="true"
                            android:focusable="true"
                            android:stateListAnimator="@animator/press_scale">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/hero_list_icon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_add" />

                                <TextView
                                    style="@style/Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:importantForAccessibility="no"
                                    android:text="My List"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </com.movies.myapplication.ui.common.GlassFrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hero_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="4dp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/home_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/home_state"
        layout="@layout/view_state" />

    <View
        android:id="@+id/home_status_scrim"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:alpha="0"
        android:background="@drawable/bg_status_scrim" />
</FrameLayout>

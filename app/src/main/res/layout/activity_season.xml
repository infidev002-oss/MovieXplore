<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <TextView
        style="@style/Text.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_7sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_7sdp"
        android:text="Choose Season" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/season_pills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_7sdp"
        android:paddingEnd="@dimen/_5sdp"
        android:paddingBottom="@dimen/_7sdp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <TextView
        android:id="@+id/season_count"
        style="@style/Text.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_13sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_13sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/season_episodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/_13sdp"
            android:paddingEnd="@dimen/_13sdp"
            android:paddingBottom="@dimen/_20sdp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <include
            android:id="@+id/season_state"
            layout="@layout/view_state" />
    </FrameLayout>

    <include layout="@layout/view_banner" />
</LinearLayout>